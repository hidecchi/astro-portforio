---
import CheckIcon from "./CheckIcon.astro";

const SERVICE_LIST = [
  {
    title: "アプリケーション開発",
    description: "TypeScriptを使用したアプリケーションの設計・開発",
    details: [
      { name: "フロントエンド開発", emphasis: true },
      { name: "バックエンド開発" },
      { name: "ネイティブアプリ開発" },
    ],
  },
  {
    title: "Webサイト制作",
    description: "高品質なWebサイト制作",
    details: [
      {
        name: "Next.jsやAstroを利用したJamStackな構成での開発",
        emphasis: true,
      },
      { name: "WebGl、GSAPを利用したアニメーションの実装" },
    ],
  },
  {
    title: "技術コンサルティング",
    description: "技術選定からアーキテクチャ設計まで、専門的なアドバイスを提供",
    details: [
      {
        name: "技術選定支援",
      },
      { name: "コードレビュー" },
      { name: "パフォーマンス改善" },
    ],
  },
];
---

<section class="service">
  <ul class="service-list">
    {
      SERVICE_LIST.map((serviceItem) => (
        <li class="service-list-item">
          <h3>{serviceItem.title}</h3>
          <p class="service-description">{serviceItem.description}</p>
          <ul>
            {serviceItem.details.map((detail) => (
              <li class="service-detail-item">
                <CheckIcon emphasis={detail.emphasis} />
                {detail.name}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .service {
    padding: 100px 24px;
  }

  .profile {
    display: grid;
    gap: 12px;
  }
  h2 {
    font-size: 24px;
  }
  h3 {
    font-size: 20px;
  }

  .certification {
    margin-top: 12px;
  }

  .service-list {
    margin-top: 12px;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 40px;
  }

  .service-list-item {
    padding: 20px;
    border: 1px solid rgba(119, 128, 161, 0.2);
    border-radius: 16px;
    display: grid;
    gap: 8px;
    background-color: white;
  }
  .service-list-item:hover {
    background-color: #ebf8f6;
  }

  .service-description {
    color: #555;
  }

  .service-detail-item {
    display: flex;
    align-items: flex-start;
    font-weight: 500;
  }

  .icon {
    margin-right: 5px;
    height: 16px;
    width: 16px;
    color: #22c55e;
    transform: translateY(5px);
  }

  @media (max-width: 900px) {
    .service {
      padding: 50px 20px;
    }
    .service-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 540px) {
    .profile-service {
      padding-top: 20px;
      padding-bottom: 20px;
    }
    .profile-service-inner {
      padding: 0 20px;
    }
  }
</style>
